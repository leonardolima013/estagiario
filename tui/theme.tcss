/* Paleta "Abismo & Neon" — SPEC.md §11, revisão v3: azul e roxo neon claros
   sobre fundo preto (era laranja/âmbar na v2). */

$background: #000000;
$surface: #0A0A1F;
$border: #2B1B4A;
$text: #C7C7E8;
$text-muted: #7A7AA6;
$accent-ai: #4FD1FF;
$accent-user: #E081FA;
$accent-tool: #6C4FF5;
$accent-warning: #FFB84D;

/* Cor por id de peça (tui/swatches.py é a fonte de verdade em runtime — DataTable
   não lê variável .tcss por célula; isto aqui é documentação/consistência). */
$part-1: #2AB7CA;
$part-2: #4C6EF5;
$part-3: #37B24D;
$part-4: #F06595;
$part-5: #845EF7;
$part-6: #15AABF;
$part-7: #94D82D;
$part-8: #E64980;

Screen {
    background: $background;
    color: $text;
}

Header {
    background: $surface;
    color: $accent-ai;
}

Footer {
    background: $surface;
    color: $text-muted;
}

Select {
    background: $surface;
    color: $text;
    border: solid $border;
}

Select:focus {
    border: solid $accent-user;
}

DataTable {
    background: $surface;
    color: $text;
    border: solid $border;
}

DataTable > .datatable--header {
    background: $surface;
    color: $accent-ai;
    text-style: bold;
}

Input {
    background: $surface;
    color: $text;
    border: solid $border;
}

Input:focus {
    border: solid $accent-user;
}

TextArea {
    background: $surface;
    color: $text;
    border: solid $border;
}

Button {
    background: $surface;
    color: $text;
    border: solid $border;
}

Button:hover {
    background: $accent-tool;
    color: $text;
}

Button.-primary {
    background: $accent-user;
    color: $background;
}

.panel-title {
    color: $accent-ai;
    text-style: bold;
    padding: 1 0 0 0;
}

.panel-explicacao {
    color: $text-muted;
    padding: 0 0 1 0;
}

.status-processando {
    color: $accent-tool;
    text-style: bold;
}

.error-message {
    color: $accent-warning;
    text-style: bold;
}

Collapsible {
    background: $surface;
    border: solid $border;
}

CollapsibleTitle {
    color: $accent-ai;
}

.registro-final {
    background: $surface;
    border: solid $accent-ai;
    padding: 1;
}

.secao-titulo {
    color: $accent-ai;
    text-style: bold;
    padding: 1 0 0 0;
}

Cabecalho {
    dock: top;
    height: auto;
    width: 100%;
    background: $background;
    padding: 1 0 1 2;
    border-bottom: solid $border;
}

#cabecalho-banner {
    width: 100%;
    text-align: left;
}

#cabecalho-subtitulo {
    width: 100%;
    text-align: left;
    color: $text-muted;
}

IntervencaoScreen {
    align: center middle;
    background: #000000 80%;
}

#intervencao-modal {
    width: 90%;
    max-width: 110;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: solid $accent-user;
    overflow-y: auto;
}

.intervencao-titulo {
    color: $accent-user;
    text-style: bold;
    padding: 0 0 1 0;
}

.intervencao-contexto {
    color: $text;
    border: solid $border;
    padding: 1;
    height: auto;
    max-height: 10;
    overflow-y: auto;
}

.intervencao-status {
    color: $accent-tool;
    height: auto;
    padding: 1 0;
}

#intervencao-regra-editor {
    border: solid $accent-ai;
    padding: 1;
    height: auto;
}

#intervencao-regra-editor TextArea {
    min-height: 4;
    height: 5;
}

#intervencao-acoes {
    height: auto;
    padding: 0 0 1 0;
}

#intervencao-resposta {
    min-height: 3;
    height: 4;
}

#intervencao-modal > Input {
    height: 3;
}

#intervencao-acoes {
    dock: bottom;
    width: 100%;
    height: 3;
    background: $surface;
    layer: overlay;
}

#intervencao-modal {
    padding-bottom: 4;
}

#intervencao-modal {
    height: 90%;
    padding-bottom: 1;
}

#intervencao-conteudo {
    height: 1fr;
    overflow-y: auto;
}

#intervencao-acoes {
    dock: none;
    width: 100%;
    height: 3;
    background: $surface;
}

/* Tela "Rodar loop": barra de controle de uma linha, linha de progresso e o
   painel de execução no resto da altura (docs/refactor-painel/DESIGN.md §5). */

.barra-controle {
    height: auto;
    margin: 0 0 0 0;
}

.barra-controle Button {
    height: 1;
    min-width: 6;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}

.barra-controle Button.-primary {
    background: $accent-user;
    color: $background;
}

.barra-controle Button:disabled {
    opacity: 50%;
}

.barra-controle Input {
    height: 1;
    width: 13;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}

.barra-controle Input:focus {
    background: $border;
}

#loop-status {
    width: 1fr;
    /* Uma linha no estado normal; mensagens longas para o operador (validação,
       cancelamento, erro) quebram e a barra cresce em vez de cortar o texto. */
    height: auto;
    color: $accent-tool;
    text-style: bold;
}

#loop-linha-progresso {
    height: 1;
}

#loop-progress {
    width: 1fr;
}

#loop-progress Bar {
    width: 1fr;
}

#loop-contadores {
    width: auto;
    height: 1;
    padding: 0 0 0 1;
    color: $text-muted;
}

#loop-rolagem {
    height: 1fr;
    border: round $border;
    padding: 0 1;
}

#loop-arquivos {
    height: auto;
    color: $text-muted;
}

/* Painel de execução (tui/execucao/widgets.py). O estado nunca depende só da
   cor: cada linha começa por um glifo (✓ ✗ ⚠ ◆ ■ ou o spinner). */

ExecutionPanel {
    height: auto;
}

.painel-vazio {
    color: $text-muted;
    padding: 1 0;
}

.painel-cabecalho {
    color: $accent-tool;
}

.painel-ocultas {
    color: $text-muted;
}

.painel-falha {
    color: $accent-warning;
}

.family-block {
    height: auto;
}

.familia-titulo {
    color: $text;
    text-style: bold;
}

.family-block:focus > .familia-titulo {
    background: $border;
}

.family-block.-em-curso > .familia-titulo {
    color: $accent-ai;
}

.family-block.-erro > .familia-titulo,
.family-block.-sinalizada > .familia-titulo {
    color: $accent-warning;
}

.family-block.-cancelada > .familia-titulo {
    color: $text-muted;
}

.familia-corpo {
    height: auto;
    padding: 0 0 0 2;
}

.item-evento {
    height: auto;
}

.item-evento:focus > .item-linha {
    background: $border;
}

.item-linha {
    color: $text;
}

.item-evento.-etapa > .item-linha,
.item-evento.-info > .item-linha {
    color: $accent-tool;
}

.item-evento.-raciocinio > .item-linha {
    color: $accent-ai;
}

.item-evento.-intervencao > .item-linha {
    color: $accent-user;
}

.item-evento.-sem-conflito > .item-linha,
.item-evento.-aviso > .item-linha {
    color: $text-muted;
}

.item-evento.-erro > .item-linha,
.item-evento.-escalado > .item-linha {
    color: $accent-warning;
}

.item-raciocinio {
    color: $text;
    padding: 0 0 0 2;
}

.item-detalhes {
    color: $text-muted;
    padding: 0 0 0 2;
}

.item-filhos {
    height: auto;
    padding: 0 0 0 2;
}

/* Tabelas da "Rodar loop": registros sorteados logo abaixo do título da família
   e registro vencedor no fim, fora do corpo recolhível (altura e recuo das
   seções ficam no DEFAULT_CSS do FamilyBlock). Sem a borda inteira do DataTable
   global (duas linhas a menos por tabela em 80x24), só uma barra à esquerda;
   tabela grande rola por dentro. */

.tabela-legenda {
    color: $text-muted;
}

.familia-vencedor > .tabela-legenda {
    color: $accent-ai;
    text-style: bold;
}

.familia-vencedor.-sem-vencedor > .tabela-legenda {
    color: $text-muted;
    text-style: none;
}

.tabela-registros,
.tabela-vencedor {
    border: none;
    border-left: tall $border;
    max-height: 45vh;
}

.tabela-vencedor {
    border-left: tall $accent-ai;
}

.tabela-registros > .datatable--fixed,
.tabela-vencedor > .datatable--fixed {
    background: $surface;
    color: $text;
}

/* Cabeçalho compacto nas telas de execução: uma linha, sempre visível. */

#cabecalho-compacto {
    display: none;
    width: 100%;
    color: $accent-ai;
    text-style: bold;
}

Cabecalho.-compacto {
    padding: 0 0 0 2;
}

Cabecalho.-compacto #cabecalho-banner,
Cabecalho.-compacto #cabecalho-subtitulo {
    display: none;
}

Cabecalho.-compacto #cabecalho-compacto {
    display: block;
}


/* Seletores "Pesquisa web" e "Coleta de HTML" da tela "Rodar testes"
   (spec html-extract-on-web-search, Req 11.3). O estado nunca depende só da
   cor: .seletor-estado sempre diz "ligada", "desligada" ou "bloqueada".
   Layout compacto (1 linha por seletor, ao lado de "Voltar ao menu") para que
   os botões de sorteio e de casos fixos continuem visíveis em 80x24 abaixo do
   banner fixo. */

.cabecalho-execucao {
    height: auto;
}

/* Linha dos casos fixos: altura do conteúdo (o padrão do Horizontal é 1fr, que
   dividia a altura com a área de resultado e deixava linhas vazias). */
.casos-fixos {
    height: auto;
}

.seletores-execucao {
    width: 1fr;
    height: auto;
    padding: 0 0 0 1;
}

.seletor-linha {
    height: auto;
}

.seletor-rotulo {
    width: 15;
    color: $text;
}

.seletor-estado {
    width: 1fr;
    height: auto;
    padding: 0 0 0 1;
    color: $text-muted;
}

.seletores-execucao Switch {
    height: 1;
    padding: 0;
    border: none;
    background: $surface;
}

.seletores-execucao Switch:focus {
    background: $border;
    text-style: bold;
}

.seletores-execucao Switch.-on .switch--slider {
    color: $accent-ai;
}

.seletores-execucao Switch:disabled {
    opacity: 60%;
}

.aviso-config {
    color: $accent-user;
    height: auto;
}
